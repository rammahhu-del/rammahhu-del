def analyseSentence(sentence):
    word_count = {}
    words = sentence.split()

    for word in words: 
        word = word.lower()

        if word in word_count: 
            word_count[word] += 1
        else:
            word_count[word] = 1
    return word_count

while True:
    user_sentence = input("Enter a sentence (or type 'exit' to stop): ")

    if user_sentence.lower() == 'exit':
        break

    result = analyseSentence(user_sentence)

    print("Words:")
    for word, count in result.items():
        print(f"{word}: {count}")
